# Copy to .env and fill in. NEVER commit your real .env / private key.

# A Sepolia RPC endpoint. Free public options (pick one):
#   https://ethereum-sepolia-rpc.publicnode.com
#   https://rpc.sepolia.org
#   https://sepolia.infura.io/v3/<YOUR_KEY>   (Infura/Alchemy if you have one)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a Sepolia-funded account (with the 0x prefix).
PRIVATE_KEY=0xyour_private_key_here

# Only needed for the interact script (Part 3/4 helper):
# FAUCET_ADDRESS=0xyour_deployed_faucet
